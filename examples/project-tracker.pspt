part appendix {
  object headerFooterLabels { productNameLabel: "Project Tracker" }
  object metadata { status: "Draft", version: "V1", lastUpdate: "Sept 1, 2026" }

  table resources {
    resource: "Resource" w1.4
    link:     "Link"     w2.6
  }
  rows resources [
    { resource: "Frontend architecture",  link: "project-tracker/docs/ARCHITECTURE.md" },
    { resource: "Backend architecture",   link: "project-tracker-api/docs/architecture.md" },
    { resource: "Roles & permissions",    link: "project-tracker-api/docs/roles.md" },
    { resource: "Granular RBAC design",   link: "project-tracker-api/docs/granular-rbac-design.md" },
    { resource: "Project hierarchy",      link: "project-tracker-api/docs/project-hierarchy.md" },
    { resource: "API reference (OpenAPI)", link: "project-tracker-api/docs/openapi.yaml" },
    { resource: "Data model source",      link: "project-tracker-api/prisma/schema.prisma" },
    { resource: "Engineering rules (FE)", link: "project-tracker/docs/RULES.md" },
    { resource: "Engineering rules (API)", link: "project-tracker-api/docs/RULES.md" },
    { resource: "Testing notes",          link: "project-tracker-api/docs/testing/" },
    { resource: "Local database stack",   link: "project-tracker-api/docker/docker-compose.yml" },
    { resource: "Design files (Figma)",   link: "[link]" },
    { resource: "CI/CD pipeline",         link: "[link]" },
    { resource: "Incident / postmortem log", link: "[link]" }
  ]
}
