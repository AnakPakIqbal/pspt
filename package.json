{
  "name": "pspt",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for pspt: product-spec-sdk + excel-tracker-sdk unified core, adapters, CLI, and DSL.",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "example:docx": "node examples/example-usage.js",
    "example:xlsx": "node examples/example-tracker-usage.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "llms:build": "node scripts/generate-llms-docs.js",
    "llms:check": "node scripts/generate-llms-docs.js --check && node scripts/sync-llms-docs.js --check && node scripts/audit-llms-docs.js",
    "llms:sync": "node scripts/generate-llms-docs.js && node scripts/sync-llms-docs.js",
    "llms:audit": "node scripts/audit-llms-docs.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "pspt-docx": "^2.0.0",
    "pspt-lang": "^2.0.0"
  }
}
